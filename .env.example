# Environment Configuration for RAG Application
# Copy this file to .env and fill in your actual values

# ==================== API Keys ====================
# OpenAI API Key (required if using OpenAI as LLM provider)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (required if using Groq as LLM provider)
GROQ_API_KEY=your_groq_api_key_here

# GitHub Token (optional, for accessing private repositories)
GITHUB_TOKEN=your_github_token_here

# ==================== LLM Configuration ====================
# LLM Provider: "openai" or "groq"
LLM_PROVIDER=groq

# LLM Model
# For Groq: "mixtral-8x7b-32768", "llama2-70b-4096"
# For OpenAI: "gpt-4", "gpt-3.5-turbo"
LLM_MODEL=mixtral-8x7b-32768

# Temperature: Controls randomness (0.0 = deterministic, 1.0 = very random)
TEMPERATURE=0.7

# ==================== Retrieval Configuration ====================
# Number of top chunks to retrieve
RETRIEVAL_K=5

# Similarity threshold (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.3

# ==================== Logging Configuration ====================
# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== Feature Flags ====================
# Enable/disable caching
ENABLE_CACHING=true

# Enable/disable analytics
ENABLE_ANALYTICS=false

# Enable advanced features
ENABLE_ADVANCED_FEATURES=true
